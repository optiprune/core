{
  "name": "framework-lab-monorepo",
  "private": true,
  "packageManager": "bun@1.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --cwd packages/core run build",
    "test": "mocha --config .mocharc.json",
    "lint": "oxlint . && biome check .",
    "format": "oxfmt --check .",
    "coverage": "c8 mocha --config .mocharc.json",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "docs": "docusaurus start",
    "openapi": "node scripts/validate-openapi.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@apollo/server": "^4.10.0",
    "graphql": "^16.8.0",
    "zod": "^3.23.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@marko-js/marko": "^5.37.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "bun-types": "^1.1.0",
    "unocss": "^0.61.0",
    "unplugin": "^1.12.0",
    "unbuild": "^2.0.0",
    "esbuild": "^0.23.0",
    "webpack": "^5.93.0",
    "vite": "^5.3.0",
    "storybook": "^8.2.0",
    "@storybook/react-vite": "^8.2.0",
    "mocha": "^10.7.0",
    "c8": "^10.1.0",
    "@docusaurus/core": "^3.4.0",
    "@docusaurus/preset-classic": "^3.4.0",
    "oxlint": "^0.5.0",
    "oxfmt": "^0.5.0",
    "@biomejs/biome": "^1.8.0",
    "openapi-schema-validator": "^12.1.3",
    "tsx": "^4.16.0",
    "eslint": "^9.8.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "chokidar": "^3.6.0",
    "lodash": "^4.17.21",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "rimraf": "^6.0.0",
    "unused-dependency": "^1.0.0"
  }
}
