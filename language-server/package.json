    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "oxfmt": "^0.65.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
