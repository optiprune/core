{
  "name": "@optiprune/language-server",
  "version": "1.17.0",
  "description": "Language Server Protocol integration for OptiPrune.",
  "keywords": [
    "language-server",
    "lsp",
    "optiprune",
    "typescript"
  ],
  "homepage": "https://opti.drml.int.yt/",
  "bugs": {
    "url": "https://github.com/optiprune/core/issues"
  },
  "license": "MIT",
