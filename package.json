{
  "name": "@optiprune/main",
  "description": "Headless API for resilient static dead-code analyzer for TypeScript and JavaScript workspaces.",
  "keywords": [
    "analysis",
    "analyze",
    "class",
    "cli",
    "dead",
    "dead code",
    "dependencies",
    "detect",
    "devDependencies",
    "duplicate",
    "entropy",
    "enum",
    "export",
    "files",
    "find",
    "javascript",
    "lint",
    "maintenance",
    "members",
    "missing",
    "monorepo",
    "namespace",
    "opti",
    "optimization",
    "optiprune",
    "package",
    "pruning",
    "scan",
    "types",
    "typescript",
    "unreferenced",
    "unresolved",
    "unused",
    "workspace"
  ],
  "workspaces": [
    "core/*",
    "docs/*"
  ],
  "homepage": "https://opti.drml.int.yt/",
  "bugs": {
    "url": "https://github.com/optiprune/core/issues"
  },
  "license": "MIT",
  "author": "DreamLongYT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiprune/core.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "language-server": "node ./dist/language-server.js",
    "test": "vitest run --no-file-parallelism",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check",
    "format": "oxfmt --ignore-path .oxfmtignore ",
    "release": "release-it"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "oxfmt": "^0.65.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.34.0",
    "@rollup/rollup-darwin-x64": "^4.34.0",
    "@rollup/rollup-linux-arm64-gnu": "^4.34.0",
    "@rollup/rollup-linux-x64-gnu": "^4.34.0",
    "@rollup/rollup-win32-arm64-msvc": "^4.34.0",
    "@rollup/rollup-win32-x64-msvc": "^4.34.0"
  }
}
