{
  "name": "@optiprune/core",
  "version": "1.16.0",
  "description": "Headless API for resilient static dead-code analyzer for TypeScript and JavaScript workspaces.",
  "keywords": [
    "analysis",
    "analyze",
    "class",
    "cli",
    "dead",
    "dead code",
    "dependencies",
    "detect",
    "devDependencies",
    "duplicate",
    "entropy",
    "enum",
    "export",
    "files",
    "find",
    "javascript",
    "lint",
    "maintenance",
    "members",
    "missing",
    "monorepo",
    "namespace",
    "opti",
    "optimization",
    "optiprune",
    "package",
    "pruning",
    "scan",
    "types",
    "typescript",
    "unreferenced",
    "unresolved",
    "unused",
    "workspace"
  ],
  "homepage": "https://opti.drml.int.yt/",
  "bugs": {
    "url": "https://github.com/optiprune/core/issues"
  },
  "license": "MIT",
  "author": "DreamLongYT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiprune/core.git"
  },
  "bin": {
    "optiprune-language-server": "./dist/language-server.js"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporters": {
      "types": "./dist/reporters.d.ts",
      "import": "./dist/reporters.js"
    },
    "./fs-utils": {
      "types": "./dist/fs-utils.d.ts",
      "import": "./dist/fs-utils.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "language-server": "node ./dist/language-server.js",
    "test": "vitest run --no-file-parallelism",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check",
    "format": "oxfmt --ignore-path .oxfmtignore ",
    "release": "release-it"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "js-yaml": "^5.2.2",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.65.0",
    "pathe": "2.0.3",
    "quickjs-emscripten": "^0.32.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.2.0",
    "yuku-ast": "^0.8.3",
    "yuku-codegen": "^0.8.3",
    "yuku-parser": "^0.8.3",
    "z3-solver": "^5.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/node": "^22.15.3",
    "release-it": "^19.2.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@yuku-codegen/wasm": "^0.8.7",
    "@yuku-parser/wasm": "^0.8.7"
  },
  "peerDependenciesMeta": {
    "@yuku-parser/wasm": {
      "optional": true
    },
    "@yuku-codegen/wasm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
