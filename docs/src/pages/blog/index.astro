---
const title = 'OptiPrune Blog';
---
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Release notes, architecture notes, and practical cleanup patterns from OptiPrune." /><link rel="icon" type="image/svg+xml" href="/assets/optiprune-logo.svg" /><link rel="stylesheet" href="/styles.css" /><title>{title}</title></head>
  <body>
    <div class="ambient ambient-a"></div><div class="ambient ambient-b"></div><div class="grid-noise"></div>
    <header class="site-header"><a class="brand" href="/"><img src="/assets/optiprune-logo.svg" alt="" /><span>OPTI<span>PRUNE</span></span></a><nav class="nav" aria-label="Primary"><a href="/docs">Docs</a><a href="/plugins">Plugins</a><a href="/blog">Blog</a><a href="https://github.com/optiprune/core">GitHub</a><a class="npm-link" href="https://www.npmjs.com/package/@optiprune/cli" aria-label="Open the OptiPrune CLI npm package"><span class="npm-icon">npm</span></a></nav><button class="theme-toggle" type="button" data-theme-toggle>◐ <span class="toggle-label">Color mode</span></button></header>
    <div id="announcement" class="announcement" hidden></div><main id="app"></main>
    <footer class="site-footer"><span>MIT License · DreamLongYT</span><span>Built for teams that ship less dead code.</span><a href="/docs">Read the documentation →</a></footer>
    <script src="/site.js" defer></script>
  </body>
</html>
